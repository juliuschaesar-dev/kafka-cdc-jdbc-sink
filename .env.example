# Copy this file to .env and adjust as needed.
# docker-compose.yml reads these for service config; the `connect` service also
# forwards the Postgres/ClickHouse values into its container environment so the
# connector JSON files (connectors/*.json) can reference them via Kafka Connect's
# built-in EnvVarConfigProvider, e.g. "${env:POSTGRES_PASSWORD}".

# --- PostgreSQL (source) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cdc_db
POSTGRES_PORT=5432

# --- Kafka (KRaft mode) ---
KAFKA_PORT=9092
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# --- Schema Registry ---
SCHEMA_REGISTRY_PORT=8081

# --- Kafka Connect ---
CONNECT_PORT=8083

# --- ClickHouse (destination) ---
CLICKHOUSE_DB=cdc_db
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000

# --- AKHQ ---
AKHQ_PORT=8080
